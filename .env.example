# ICC-CE 本体仓库路径（支持相对于本仓库的相对路径或绝对路径）
ICC_CE_PATH=../iccce

# WebEasiNote 前端仓库路径（可选，默认 ../WebEasiNote）
WEB_EASINOTE_PATH=../WebEasiNote

# 编译配置（可选：Debug 或 Release，默认 Debug）
BUILD_CONFIGURATION=Debug

# 启用 WebView2 前端 DevTools（按 F12 或 Ctrl+Shift+I 唤起开发者工具，默认 1）
ICC_CE_ENBX_DEVTOOLS=1

# 宿主启动参数（可选：默认 --show 展开浮动工具栏；可改为 --board 直接进入全屏白板）
HOST_ARGS=--show

# 启动时自动打开的测试课件文件（可选，填写 .enbx 文件的绝对或相对路径）
# ENBX_FILE=D:/path/to/demo.enbx

