<UserControl x:Class="ICC.CE.ENBX.Seewo.UI.SeewoBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="980"
             Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Fluent 列表项样式（带圆角、悬停、双击事件） -->
        <Style x:Key="FluentListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="MouseDoubleClick" Handler="OnListItemMouseDoubleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" CornerRadius="6" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent 侧边栏导航条目样式 -->
        <Style x:Key="FluentNavItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBorder" CornerRadius="6" Background="{TemplateBinding Background}" Padding="10,0">
                            <Grid>
                                <!-- 选中指示器：左侧 AccentColor 胶囊竖条 -->
                                <Border x:Name="IndicatorPill" Width="3" Height="16" CornerRadius="1.5" 
                                        Background="#1890FF" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                        Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                <Setter TargetName="IndicatorPill" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#096DD9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" MinWidth="180" MaxWidth="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧 Fluent 导航面板（无 emoji，符合现代 Fluent 导航栏） -->
        <Border Grid.Column="0" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="12,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="课件库" FontSize="13" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="10,0,0,12"/>

                <!-- Fluent 导航选项 -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="TabAllCoursewares" IsChecked="True" 
                                 Style="{StaticResource FluentNavItemStyle}" Click="OnTabSelectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Folder 矢量图标 -->
                            <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="全部课件与目录" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabRecentCoursewares" 
                                 Style="{StaticResource FluentNavItemStyle}" Click="OnTabSelectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Clock 矢量图标 -->
                            <Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="最近使用" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabDownloadedCoursewares" 
                                 Style="{StaticResource FluentNavItemStyle}" Click="OnTabSelectionChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Downloaded 矢量图标 -->
                            <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="本地缓存" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 底部统计与缓存管理 -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TextSummary" Text="正在同步..." FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Button Content="打开本地缓存目录" Click="OnOpenCacheFolderClick" 
                                HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="6,5" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧主内容区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部工具栏与面包屑 -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 返回上一级按钮 -->
                    <Button x:Name="BtnBack" Grid.Column="0" Content="返回上一级" Click="OnBackFolderClick" 
                            IsEnabled="False" Margin="0,0,12,0" Padding="10,5"/>

                    <!-- 面包屑导航 -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- 搜索框 -->
                    <TextBox x:Name="SearchBox" Grid.Column="2" Width="220" Margin="12,0,8,0" 
                             VerticalContentAlignment="Center" TextChanged="OnSearchTextChanged"
                             ui:ControlHelper.PlaceholderText="搜索课件名称..."/>

                    <!-- 刷新按钮 -->
                    <Button Grid.Column="3" Content="刷新" Click="OnRefreshClick" Padding="12,5"/>
                </Grid>
            </Border>

            <!-- 课件与目录列表 -->
            <Grid Grid.Row="1">
                <!-- 列表表头与内容容器 -->
                <Grid Margin="18,10,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 表头 -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,8" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="名称" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="修改时间" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="大小" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- 课件与目录列表 -->
                    <ListView x:Name="CoursewareListView" Grid.Row="1"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ItemContainerStyle="{StaticResource FluentListItemStyle}"
                              KeyDown="OnListViewKeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 名称列 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 文件夹矢量图标（仅文件夹显示） -->
                                        <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" 
                                              Fill="#FA8C16" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"
                                              Visibility="{Binding FolderVisibility}"/>

                                        <!-- 课件图标（仅课件显示） -->
                                        <Image Source="pack://application:,,,/ICC.CE.ENBX;component/Resources/seewo_icon.png" 
                                               Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding CoursewareVisibility}"/>

                                        <!-- 课件/目录名称 -->
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>

                                    <!-- 更新时间列 -->
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayUpdateTime}" FontSize="12" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>

                                    <!-- 大小列 -->
                                    <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" FontSize="12" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- 空状态提示（无 emoji） -->
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" 
                          Fill="{DynamicResource TextFillColorTertiaryBrush}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                    <TextBlock Text="当前文件夹没有课件" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 正在加载动画 -->
                <Border x:Name="LoadingPanel" Background="#88FFFFFF" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsActive="True" Width="38" Height="38"/>
                        <TextBlock Text="正在同步希沃云课件..." Margin="0,12,0,0" FontSize="13" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 底部下载进度条 -->
            <Border x:Name="DownloadBar" Grid.Row="2" Background="#F6FFED" BorderBrush="#B7EB8F" BorderThickness="0,1,0,0" 
                    Padding="18,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="下载中" FontWeight="SemiBold" Foreground="#389E0D" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid Margin="0,0,12,4">
                            <TextBlock x:Name="TextDownloadStatus" Text="准备下载..." FontSize="12" Foreground="#262626"/>
                            <TextBlock x:Name="TextDownloadPercent" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#389E0D" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="ProgressDownload" Height="6" Maximum="100" Value="0" Foreground="#52C41A"/>
                    </StackPanel>
                    
                    <Button Grid.Column="2" Content="取消" Click="OnCancelDownloadClick" Padding="12,4" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
