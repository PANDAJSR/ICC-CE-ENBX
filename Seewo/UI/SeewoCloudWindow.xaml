<Window x:Class="ICC.CE.ENBX.Seewo.UI.SeewoCloudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         mc:Ignorable="d"
         Title="希沃云课件" Height="680" Width="1040" MinWidth="850" MinHeight="550"
         WindowStartupLocation="CenterScreen"
         ResizeMode="CanResize"
         ui:ThemeManager.IsThemeAware="True"
         ui:TitleBar.ExtendViewIntoTitleBar="True"
         ui:WindowHelper.SystemBackdropType="None"
         ui:WindowHelper.UseModernWindowStyle="True"
         ui:WindowHelper.CornerStyle="Round"
         ui:TitleBar.Height="48"
         Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
         Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <ui:ThemeResources CanBeAccessedAcrossThreads="True" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 与 ICC-CE 设置页一致：内容叠加到系统标题栏，右侧为系统控制键预留空间。 -->
        <Border Grid.Row="0" x:Name="AppTitleBar"
                Height="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=(ui:TitleBar.Height)}"
                Background="Transparent" IsHitTestVisible="True" Panel.ZIndex="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧 Logo 与标题（已去掉 ENBX 集成版标签） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/ICC.CE.ENBX;component/Resources/seewo_icon.png" 
                           Width="20" Height="20" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="希沃云课件" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <!-- 右侧用户状态与操作（无 emoji，支持真实头像与 Fluent 胶囊样式） -->
                 <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- 查看日志按钮 -->
                    <Button Content="诊断日志" Click="OnViewLogsClick" Padding="8,4" FontSize="11" 
                            Background="Transparent" BorderThickness="0" Margin="0,0,12,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <!-- 用户信息条 -->
                    <Button x:Name="UserInfoPanel" Click="OnAccountMenuClick" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="6,3,10,3" Visibility="Collapsed" ToolTip="切换或管理希沃账号" AutomationProperties.Name="切换或管理希沃账号">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 真实头像圆形裁剪 -->
                            <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Background="#E6F4FF" Margin="0,0,8,0">
                                <Grid>
                                    <!-- 默认矢量占位图 -->
                                    <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                                          Fill="#1890FF" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <!-- 真实网络头像 -->
                                    <Image x:Name="ImgUserAvatar" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TextUserName" Text="希沃用户" FontWeight="Medium" FontSize="12" VerticalAlignment="Center"/>
                            
                            <Rectangle Width="1" Height="12" Fill="{DynamicResource CardStrokeColorDefaultBrush}" Margin="10,0"/>

                            <TextBlock Text="▾" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- 系统标题栏控制键区域，不能被自绘内容覆盖。 -->
                <Rectangle Grid.Column="2"
                           Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=(ui:TitleBar.SystemOverlayRightInset)}" />
            </Grid>
        </Border>

        <!-- 主内容切换区 -->
        <Grid Grid.Row="1" x:Name="MainContentContainer"/>
    </Grid>
</Window>
