<Window x:Class="ICC.CE.ENBX.Seewo.UI.SeewoCloudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="希沃云课件" Height="680" Width="1040" MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧 Logo 与标题（已去掉 ENBX 集成版标签） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/ICC.CE.ENBX;component/Resources/seewo_icon.png" 
                           Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="希沃云课件" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <!-- 右侧用户状态与操作（无 emoji，支持真实头像与 Fluent 胶囊样式） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 查看日志按钮 -->
                    <Button Content="诊断日志" Click="OnViewLogsClick" Padding="8,4" FontSize="11" 
                            Background="Transparent" BorderThickness="0" Margin="0,0,12,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <!-- 用户信息条 -->
                    <Border x:Name="UserInfoPanel" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="6,3,10,3" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 真实头像圆形裁剪 -->
                            <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Background="#E6F4FF" Margin="0,0,8,0">
                                <Grid>
                                    <!-- 默认矢量占位图 -->
                                    <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                                          Fill="#1890FF" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <!-- 真实网络头像 -->
                                    <Image x:Name="ImgUserAvatar" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TextUserName" Text="希沃用户" FontWeight="Medium" FontSize="12" VerticalAlignment="Center"/>
                            
                            <Rectangle Width="1" Height="12" Fill="{DynamicResource CardStrokeColorDefaultBrush}" Margin="10,0"/>

                            <Button Content="退出" Click="OnLogoutClick" Padding="4,2" FontSize="11" 
                                    Background="Transparent" BorderThickness="0" Foreground="#E03131" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容切换区 -->
        <Grid Grid.Row="1" x:Name="MainContentContainer"/>
    </Grid>
</Window>
