<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ICC.CE.ENBX</RootNamespace>
    <AssemblyName>ICC.CE.ENBX</AssemblyName>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <CreateIcpx>true</CreateIcpx>
    <UseLocalPluginSdk Condition="'$(UseLocalPluginSdk)' == '' and Exists('..\iccce\InkCanvas.PluginSdk\InkCanvas.PluginSdk.csproj')">true</UseLocalPluginSdk>
    <IcpxPackageName>com.pandajsr.icc-ce-enbx.icpx</IcpxPackageName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="InkCanvas.PluginSdk" Version="1.8.0.2-gbd4880718d" Condition="'$(UseLocalPluginSdk)' != 'true'">
      <Private>false</Private>
    </PackageReference>
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalPluginSdk)' == 'true'">
    <ProjectReference Include="..\iccce\InkCanvas.PluginSdk\InkCanvas.PluginSdk.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="tools\SeewoImBridge\SeewoImBridge.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Import Project="..\iccce\InkCanvas.PluginSdk\InkCanvas.PluginSdk.targets" Condition="'$(UseLocalPluginSdk)' == 'true'" />

  <ItemGroup Condition="Exists('..\WebEasiNote\dist')">
    <EmbeddedResource Include="..\WebEasiNote\dist\**\*.*">
      <LogicalName>ICC.CE.ENBX.Web.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <UpToDateCheckInput Include="..\WebEasiNote\dist\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <Compile Include="src\**\*.cs" />
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="icon_mono.png" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Resources\**\*.*" />
    <None Update="Resources\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopySeewoImBridge" AfterTargets="Build" BeforeTargets="CreateIcpxPackage">
    <Delete Files="$(OutputPath)SeewoImBridge.exe;$(OutputPath)SeewoImBridge.deps.json;$(OutputPath)SeewoImBridge.runtimeconfig.json" />
    <ItemGroup>
      <SeewoBridgeFiles Include="tools\SeewoImBridge\bin\$(Configuration)\net10.0-windows\win-x86\SeewoImBridge.exe;tools\SeewoImBridge\bin\$(Configuration)\net10.0-windows\win-x86\SeewoImBridge.dll;tools\SeewoImBridge\bin\$(Configuration)\net10.0-windows\win-x86\SeewoImBridge.deps.json;tools\SeewoImBridge\bin\$(Configuration)\net10.0-windows\win-x86\SeewoImBridge.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(SeewoBridgeFiles)" DestinationFolder="$(OutputPath)SeewoImBridge" SkipUnchangedFiles="true" />
  </Target>
</Project>
